{
  "name": "@dsh-external/dsh-task-widget",
  "version": "0.3.1",
  "description": "Windows 桌面独立小组件（液态玻璃任务台）：聚合全部任务与进度、完成提醒（toast+提示音）、当前/剩余 Token 用量、账户余额；深/浅色跟随系统。设置页可调强调色/玻璃与卡片透明度；独立 Token 用量卡；任务点击跳转对应会话；位置锁定。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "widget",
    "scripts",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "bash scripts/build.sh"
  }
}
